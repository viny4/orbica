# ORBICA — environment template. Copy to .env and fill in secrets.

# --- Postgres (PostGIS + pg_trgm) ---
# Local docker-compose values. In production this points at Supabase — use the
# POOLER host (aws-0-<region>.pooler.supabase.com), not db.<ref>.supabase.co,
# which resolves to IPv6 only and is unreachable from Render and GitHub Actions.
POSTGRES_USER=rocketpedia
POSTGRES_PASSWORD=rocketpedia
POSTGRES_DB=rocketpedia
POSTGRES_URL=postgresql://rocketpedia:rocketpedia@localhost:5432/rocketpedia

# --- Caches / search / streaming ---
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_LAUNCHES=launches.new
KAFKA_TOPIC_TLE=tle.updates

# --- External data sources ---
LL2_API_KEY=
LL2_BASE_URL=https://ll.thespacedevs.com/2.3.0
CELESTRAK_BASE_URL=https://celestrak.org
NASA_API_KEY=
SPACE_TRACK_USER=
SPACE_TRACK_PASS=

# --- Auth ---
JWT_SECRET=change-me-in-prod

# --- Service ports ---
# The live tracker is served by the Go API itself (there is no separate tracker
# process), so API_PORT covers both REST and the /ws stream.
# Do NOT set PORT here: hosts inject it themselves, and locally it would
# override API_PORT and put the API on the frontend's port.
API_PORT=8090
PIPELINE_PORT=8000

# --- Frontend ---
# The WebSocket URL is derived from this by swapping http -> ws.
NEXT_PUBLIC_API_URL=http://localhost:8090

# --- Supabase (production data path) ---
# With these set, the frontend queries Postgres directly through PostgREST and
# the Go API above becomes an optional fallback, so the site survives the API
# host being down. Leave blank for local development.
# The anon key is public by design (it is baked into the client bundle); every
# api_* function is read-only and RLS denies anon all direct table access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to "rest" to force the Go API back in front of Supabase.
NEXT_PUBLIC_API_PRIMARY=

# --- AWS (prod) ---
AWS_S3_BUCKET=orbica-media
AWS_CLOUDFRONT_URL=



# Go API per-IP rate limit (requests/minute); default 120
RATE_LIMIT_PER_MIN=120
