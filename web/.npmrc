# The Cloudflare Pages build runs 'npx @cloudflare/next-on-pages@1', which
# declares peerOptional @cloudflare/workers-types@^4 while the wrangler it
# resolves now requires ^5 — npx re-resolves on every build, so a new wrangler
# release broke deploys with ERESOLVE before compiling anything. Both peers are
# optional; relaxing resolution is safe. (Same fix as orbica-admin-web.)
legacy-peer-deps=true
